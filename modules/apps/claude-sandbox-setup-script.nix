# The Claude Code cloud environment's setup script for this commit.
#
# nix run .#claude-sandbox-setup-script
#
# A cloud session cannot evaluate this flake (its GitHub gate refuses github:
# inputs), so the environment consumes a closure: CI builds the claude-sandbox
# activation package (checks.x86_64-linux.home-manager-claude-sandbox) and
# pushes it to cache.scientistexperience.net, and the setup script names it by
# store path, realises it from the caches and activates it. The commit is the
# script's provenance. The bootstrap report is written by the activation itself
# (vanixiets.sandbox.bootstrapReport); this script adds one marker line per run
# so that a run whose realise failed, and so never activated, is visible too.
#
# The script must exit 0 on every path: a non-zero setup step stops the session
# from starting (A170). The platform limits it to 100 lines of 200 bytes
# (A175); the `claude-sandbox-setup-script` check holds it to both.
{ self, lib, ... }:
let
  caches = import ../../lib/caches.nix;
  hosts = [
    "cache.scientistexperience.net"
    "cache.nixos.org"
  ];
  pick =
    prefix: entries:
    let
      picked = lib.filter (e: lib.any (h: lib.hasPrefix (prefix h) e) hosts) entries;
    in
    assert lib.assertMsg (
      lib.length picked == lib.length hosts
    ) "lib/caches.nix must name exactly one entry per host in ${toString hosts}";
    picked;
  substituters = pick (h: "https://${h}") caches.substituters;
  publicKeys = pick (h: "${h}-") caches.publicKeys;

  activationPackage =
    builtins.unsafeDiscardStringContext
      self.homeConfigurations."claude-sandbox@x86_64-linux".activationPackage.outPath;
  rev = self.rev or self.dirtyRev or "unknown";
  date =
    let
      d = self.lastModifiedDate or "00000000000000";
    in
    "${lib.substring 0 4 d}-${lib.substring 4 2 d}-${lib.substring 6 2 d}";
in
{
  flake.lib.claudeSandboxSetupScript = {
    inherit activationPackage;
    text = lib.concatLines [
      "#!/bin/bash"
      "# claude-sandbox setup: vanixiets ${rev} (${date})"
      "# generated by: nix run .#claude-sandbox-setup-script"
      "P=${activationPackage}"
      "S='${lib.concatStringsSep " " substituters}'"
      "K='${lib.concatStringsSep " " publicKeys}'"
      "L=/var/log/claude-sandbox-bootstrap"
      "mkdir -p \"$L\""
      "t0=$(date +%s)"
      "timeout 600 nix-store -r \"$P\" --option substituters \"$S\" --option trusted-public-keys \"$K\" >>\"$L/run.log\" 2>&1"
      "rr=$? t1=$(date +%s) ar=skipped"
      "# A run that finds P already current leaves /root alone (R11)."
      "[ \"$(readlink -f /root/.local/state/home-manager/gcroots/current-home)\" = \"$P\" ] && ar=current"
      "[ \"$rr\" = 0 ] && [ \"$ar\" = skipped ] && { USER=root HOME=/root timeout 240 \"$P/activate\" >>\"$L/run.log\" 2>&1; ar=$?; }"
      "t2=$(date +%s) n=$(nix-store --version 2>&1 | awk '{print $NF}')"
      "echo \"$(date -u +%FT%TZ) rev=${rev} realise=$rr/$((t1-t0))s activate=$ar/$((t2-t1))s nix=$n P=$P\" >>\"$L/setup.log\""
      "exit 0"
    ];
  };

  perSystem =
    { pkgs, ... }:
    {
      apps.claude-sandbox-setup-script = {
        type = "app";
        program = lib.getExe (
          pkgs.writeShellScriptBin "claude-sandbox-setup-script" ''
            cat ${pkgs.writeText "claude-sandbox-setup.sh" self.lib.claudeSandboxSetupScript.text}
          ''
        );
      };
    };
}
