# The Claude Code cloud environment's setup script, in two modes.
#
# nix run .#claude-sandbox-setup-script -- --track
# nix run .#claude-sandbox-setup-script [FLAKE]
#
# Track mode prints fixed text: no revision, store path or date, so a new commit
# on main changes neither the cloud environment's setup step (a change to it
# costs an approval card and a snapshot rebuild) nor any derivation here. The
# script walks main's 5 newest first-parent commits from the tip and evaluates
# each one's claude-sandbox activation package with the two caches as
# substituters, which serve every input source a cloud session needs (A184). It
# accepts the first path whose narinfo cache.scientistexperience.net serves,
# realises it without building and activates it. A failed evaluation is a miss
# too (a lock change whose sources are not uploaded yet). Setting its `PIN=` line
# to a pinned script's `P=` bypasses the walk.
#
# The commits are listed by a shallow, treeless clone of main: 5 commit objects,
# about 20 KiB, where a per-commit `?rev=…&shallow=1` fetch cannot name the
# parents at all and ls-remote names only the tip. The plain shallow clone after
# it is the form the Q97 probe saw the GitHub gate serve, in case the gate
# refuses the filter. Narinfos are asked for by `nix path-info`, through the
# client that the probe saw reach the cache, rather than by curl.
#
# The pinned mode prints the script for one commit's closure, the form that
# predates track mode and that produces PIN values: CI builds the claude-sandbox
# activation package (checks.x86_64-linux.home-manager-claude-sandbox) and
# pushes it to cache.scientistexperience.net, and the setup script names it by
# store path, realises it from the caches and activates it. The commit is the
# script's provenance. The bootstrap report is written by the activation itself
# (vanixiets.sandbox.bootstrapReport); this script adds one marker line per run
# so that a run whose realise failed, and so never activated, is visible too.
#
# The pinned template holds no commit-dependent value either: its derivation,
# the app and the check would otherwise rebuild on every commit. The app fills
# the provenance placeholders in at run time from the flake it is pointed at
# (default `.`): `nix flake metadata` first, `git` as the fallback.
#
# Either script must exit 0 on every path: a non-zero setup step stops the
# session from starting (A170). The platform limits it to 100 lines of 200 bytes
# (A175); the `claude-sandbox-setup-script` check holds both templates to that.
{ self, lib, ... }:
let
  caches = import ../../lib/caches.nix;
  hosts = [
    "cache.scientistexperience.net"
    "cache.nixos.org"
  ];
  pick =
    prefix: entries:
    let
      picked = lib.filter (e: lib.any (h: lib.hasPrefix (prefix h) e) hosts) entries;
    in
    assert lib.assertMsg (
      lib.length picked == lib.length hosts
    ) "lib/caches.nix must name exactly one entry per host in ${toString hosts}";
    picked;
  substituters = pick (h: "https://${h}") caches.substituters;
  publicKeys = pick (h: "${h}-") caches.publicKeys;
  fleetCache = lib.head (lib.filter (lib.hasPrefix "https://${lib.head hosts}") substituters);
  repository = "https://github.com/cameronraysmith/vanixiets";

  activationPackage =
    builtins.unsafeDiscardStringContext
      self.homeConfigurations."claude-sandbox@x86_64-linux".activationPackage.outPath;
  placeholders = {
    rev = "@REV@";
    date = "@DATE@";
  };
in
{
  flake.lib.claudeSandboxSetupScript = {
    inherit activationPackage placeholders repository;
    template = lib.concatLines [
      "#!/bin/bash"
      "# claude-sandbox setup: vanixiets ${placeholders.rev} (${placeholders.date})"
      "# generated by: nix run .#claude-sandbox-setup-script"
      "P=${activationPackage}"
      "S='${lib.concatStringsSep " " substituters}'"
      "K='${lib.concatStringsSep " " publicKeys}'"
      "L=/var/log/claude-sandbox-bootstrap"
      "mkdir -p \"$L\""
      "t0=$(date +%s)"
      "timeout 600 nix-store -r \"$P\" --option substituters \"$S\" --option trusted-public-keys \"$K\" >>\"$L/run.log\" 2>&1"
      "rr=$? t1=$(date +%s) ar=skipped"
      "# A run that finds P already current leaves /root alone (R11)."
      "[ \"$(readlink -f /root/.local/state/home-manager/gcroots/current-home)\" = \"$P\" ] && ar=current"
      "[ \"$rr\" = 0 ] && [ \"$ar\" = skipped ] && { USER=root HOME=/root timeout 240 \"$P/activate\" >>\"$L/run.log\" 2>&1; ar=$?; }"
      "t2=$(date +%s) n=$(nix-store --version 2>&1 | awk '{print $NF}')"
      "echo \"$(date -u +%FT%TZ) rev=${placeholders.rev} realise=$rr/$((t1-t0))s activate=$ar/$((t2-t1))s nix=$n P=$P\" >>\"$L/setup.log\""
      "exit 0"
    ];

    # Substituters and keys are bash arrays, joined into one word each by
    # "${S[*]}": the Q97 probe saw an unquoted string split into arguments.
    trackTemplate = ''
      #!/bin/bash
      # claude-sandbox setup, track mode: the newest of main's 5 newest commits whose closure the fleet cache serves.
      # generated by: nix run .#claude-sandbox-setup-script -- --track (fixed text: new commits leave it unchanged)
      # To pin one closure, set PIN to the P= of a pinned script (nix run .#claude-sandbox-setup-script).
      #PIN=
      R=${repository}
      C=${lib.escapeShellArg fleetCache}
      S=(${lib.escapeShellArgs substituters})
      K=(${lib.escapeShellArgs publicKeys})
      O=(--option substituters "''${S[*]}" --option trusted-public-keys "''${K[*]}" --option accept-flake-config false)
      A='homeConfigurations."claude-sandbox@x86_64-linux".activationPackage.outPath'
      L=/var/log/claude-sandbox-bootstrap
      mkdir -p "$L"
      t0=$(date +%s) P=''${PIN:-} mode=pin tip=none rev=none dist=none skip=''' er=none
      if [ -z "$P" ]; then
        mode=track D=$(mktemp -d) i=0
        # main's 5 newest commit objects only; the plain shallow clone if the filter is refused.
        timeout 60 git clone -q --bare --depth 5 --filter=tree:0 --single-branch -b main "$R" "$D" >>"$L/run.log" 2>&1 ||
          timeout 120 git clone -q --bare --depth 5 --single-branch -b main "$R" "$D" >>"$L/run.log" 2>&1
        for c in $(git -C "$D" rev-list --first-parent -n 5 main 2>>"$L/run.log"); do
          [ "$i" = 0 ] && tip=$c
          left=$((t0 + 300 - $(date +%s)))
          [ "$left" -gt 0 ] || { skip="$skip,''${c:0:12}:budget"; break; }
          p=$(timeout "$left" nix eval --raw "''${O[@]}" "git+$R?rev=$c&shallow=1#$A" 2>>"$L/run.log"); er=$?
          if [ "$er" != 0 ]; then skip="$skip,''${c:0:12}:eval/$er"
          elif nix path-info --store "$C" --option narinfo-cache-negative-ttl 0 "$p" >/dev/null 2>>"$L/run.log"; then
            P=$p rev=$c dist=$i
            break
          else skip="$skip,''${c:0:12}:narinfo"; fi
          i=$((i + 1))
        done
        rm -rf "$D"
      fi
      t1=$(date +%s) rr=skipped ar=skipped
      # Substitute only: a path neither cache serves fails the realise instead of building.
      [ -n "$P" ] && { timeout 600 nix-store -r "$P" --max-jobs 0 --option builders ''' "''${O[@]}" >>"$L/run.log" 2>&1; rr=$?; }
      t2=$(date +%s)
      # A run that finds P already current leaves /root alone (R11); setup runs twice on first use.
      [ -n "$P" ] && [ "$(readlink -f /root/.local/state/home-manager/gcroots/current-home)" = "$P" ] && ar=current
      [ "$rr" = 0 ] && [ "$ar" = skipped ] && { USER=root HOME=/root timeout 240 "$P/activate" >>"$L/run.log" 2>&1; ar=$?; }
      t3=$(date +%s) n=$(nix-store --version 2>&1 | awk '{print $NF}')
      m="mode=$mode tip=$tip rev=$rev dist=$dist skip=''${skip#,} eval=$er/$((t1-t0))s"
      echo "$(date -u +%FT%TZ) $m realise=$rr/$((t2-t1))s activate=$ar/$((t3-t2))s nix=$n P=''${P:-none}" >>"$L/setup.log"
      exit 0
    '';
  };

  perSystem =
    { pkgs, ... }:
    let
      inherit (self.lib.claudeSandboxSetupScript) template trackTemplate placeholders;
    in
    {
      apps.claude-sandbox-setup-script = {
        type = "app";
        program = lib.getExe (
          pkgs.writeShellApplication {
            name = "claude-sandbox-setup-script";
            runtimeInputs = [
              pkgs.coreutils
              pkgs.git
              pkgs.gnused
              pkgs.jq
            ];
            # nix is the caller's: the one `nix run` was invoked with.
            text = ''
              if [ "''${1:-}" = --track ]; then
                cat ${pkgs.writeText "claude-sandbox-setup-track.sh" trackTemplate}
                exit 0
              fi
              flake=''${1:-.}
              rev=
              modified=
              if metadata=$(nix flake metadata --json "$flake" 2>/dev/null); then
                rev=$(jq -r '.revision // .dirtyRevision // empty' <<<"$metadata")
                modified=$(jq -r '.lastModified // empty' <<<"$metadata")
              fi
              if [ -z "$rev" ] && [ -d "$flake" ]; then
                rev=$(git -C "$flake" rev-parse HEAD)
                modified=$(git -C "$flake" log -1 --format=%ct)
              fi
              if [ -z "$rev" ] || [ -z "$modified" ]; then
                echo "claude-sandbox-setup-script: cannot read the revision of $flake" >&2
                exit 1
              fi
              date=$(date -u -d "@$modified" +%F)
              sed -e "s/${placeholders.rev}/$rev/g" -e "s/${placeholders.date}/$date/g" \
                ${pkgs.writeText "claude-sandbox-setup.sh" template}
            '';
          }
        );
      };
    };
}
