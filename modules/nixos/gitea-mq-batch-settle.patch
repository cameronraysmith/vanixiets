+// settled reports whether the queued entries for targetBranch may form a new
+// root batch now. It returns false while the queue is still receiving
+// enqueues within the Settle window; the next poll tick or webhook retries.
+func (e *Engine) settled(ctx context.Context, targetBranch string) (bool, error) {
+	if e.Settle <= 0 {
+		return true, nil
+	}
+	entries, err := e.Queue.List(ctx, e.RepoID, targetBranch)
+	if err != nil {
+		return false, err
+	}
+	queued := slices.DeleteFunc(entries, func(q pg.QueueEntry) bool { return q.State != pg.EntryStateQueued })
+	if len(queued) == 0 || (e.BatchMax > 0 && len(queued) >= e.BatchMax) {
+		return true, nil
+	}
+	now := time.Now()
+	if e.Now != nil {
+		now = e.Now()
+	}
+	// ListQueue orders by enqueued_at ascending.
+	oldest, newest := queued[0].EnqueuedAt.Time, queued[len(queued)-1].EnqueuedAt.Time
+	if now.Sub(newest) >= e.Settle || (e.SettleMax > 0 && now.Sub(oldest) >= e.SettleMax) {
+		return true, nil
+	}
+	slog.Debug("batch settling", "branch", targetBranch, "queued", len(queued),
+		"since_newest", now.Sub(newest), "since_oldest", now.Sub(oldest))
+	return false, nil
+}
