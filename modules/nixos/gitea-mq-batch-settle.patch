+// settleQueue is setup with a controllable clock and enqueue times: each PR
+// is enqueued and its enqueued_at pinned to t0+offset.
+type settleQueue struct {
+	t   *testing.T
+	ctx context.Context
+	e   *batch.Engine
+	svc *queue.Service
+	t0  time.Time
+	now time.Time
+	pin func(pr int64, at time.Time)
+}
+
+func setupSettle(t *testing.T, batchMax int, settle, settleMax time.Duration) *settleQueue {
+	t.Helper()
+	pool := testutil.TestDB(t)
+	svc := queue.NewService(pool)
+	ctx := t.Context()
+	repo, err := svc.GetOrCreateRepo(ctx, "gitea", "org", "app")
+	if err != nil {
+		t.Fatal(err)
+	}
+	s := &settleQueue{t: t, ctx: ctx, svc: svc, t0: time.Now().Truncate(time.Second)}
+	s.now = s.t0
+	s.pin = func(pr int64, at time.Time) {
+		if _, err := pool.Exec(ctx, "UPDATE queue_entries SET enqueued_at = $1 WHERE repo_id = $2 AND pr_number = $3", at, repo.ID, pr); err != nil {
+			t.Fatal(err)
+		}
+	}
+	s.e = &batch.Engine{
+		Forge:              newFakeForge().MockForge,
+		Queue:              svc,
+		Owner:              "org",
+		Repo:               "app",
+		RepoID:             repo.ID,
+		ExternalURL:        "http://mq",
+		BatchMax:           batchMax,
+		Settle:             settle,
+		SettleMax:          settleMax,
+		Now:                func() time.Time { return s.now },
+		MergedPollInterval: 1,
+		MergedPollAttempts: 1,
+	}
+	return s
+}
+
+// enqueue adds pr with enqueued_at = t0+offset.
+func (s *settleQueue) enqueue(pr int64, offset time.Duration) {
+	s.t.Helper()
+	if _, err := s.svc.Enqueue(s.ctx, s.e.RepoID, pr, fmt.Sprintf("sha%d", pr), "main"); err != nil {
+		s.t.Fatal(err)
+	}
+	s.pin(pr, s.t0.Add(offset))
+}
+
+// formAt runs FormAndBuild with the clock at t0+offset.
+func (s *settleQueue) formAt(offset time.Duration) *pg.Batch {
+	s.t.Helper()
+	s.now = s.t0.Add(offset)
+	b, err := s.e.FormAndBuild(s.ctx, "main")
+	if err != nil {
+		s.t.Fatal(err)
+	}
+	return b
+}
+
+func (s *settleQueue) wantNoBatch(offset time.Duration) {
+	s.t.Helper()
+	if b := s.formAt(offset); b != nil {
+		s.t.Fatalf("t0+%v: formed batch %d with %d members while settling", offset, b.ID, len(b.MemberIds))
+	}
+	if live, err := s.svc.GetLiveBatch(s.ctx, s.e.RepoID, "main"); err != nil || live != nil {
+		s.t.Fatalf("t0+%v: live batch %v (err %v) while settling", offset, live, err)
+	}
+}
+
+func (s *settleQueue) wantBatch(offset time.Duration, members int) {
+	s.t.Helper()
+	b := s.formAt(offset)
+	if b == nil {
+		s.t.Fatalf("t0+%v: no batch formed", offset)
+	}
+	if len(b.MemberIds) != members || b.State != pg.BatchStateTesting {
+		s.t.Fatalf("t0+%v: batch members=%d state=%s, want %d testing", offset, len(b.MemberIds), b.State, members)
+	}
+}
+
+// Serial enqueues 2s apart share one batch once the queue is quiet for Settle.
+func TestFormAndBuild_SettleWaitsForQuietQueue(t *testing.T) {
+	s := setupSettle(t, 20, 15*time.Second, 0)
+	for i, pr := range []int64{10, 20, 30, 40} {
+		s.enqueue(pr, time.Duration(2*i)*time.Second)
+	}
+	s.wantNoBatch(6 * time.Second)
+	s.wantNoBatch(20 * time.Second)
+	s.wantBatch(21*time.Second, 4)
+}
+
+// A full batch does not wait for the queue to go quiet.
+func TestFormAndBuild_SettleSkippedAtBatchMax(t *testing.T) {
+	s := setupSettle(t, 4, 15*time.Second, 0)
+	for i, pr := range []int64{10, 20, 30, 40} {
+		s.enqueue(pr, time.Duration(2*i)*time.Second)
+	}
+	s.wantBatch(6*time.Second, 4)
+}
+
+// SettleMax forms the batch even though enqueues keep resetting Settle.
+func TestFormAndBuild_SettleMaxBoundsWait(t *testing.T) {
+	s := setupSettle(t, 20, 15*time.Second, 2*time.Minute)
+	s.enqueue(10, 0)
+	for i, pr := range []int64{20, 30, 40, 50, 60, 70, 80, 90, 100, 110, 120} {
+		at := time.Duration(10*(i+1)) * time.Second // t0+10s … t0+110s
+		s.enqueue(pr, at)
+		s.wantNoBatch(at + 5*time.Second)
+	}
+	s.enqueue(130, 118*time.Second)
+	s.wantNoBatch(119 * time.Second)
+	s.wantBatch(120*time.Second, 13)
+}
+
+// Settle=0 keeps the immediate formation of the unpatched engine.
+func TestFormAndBuild_SettleZeroFormsImmediately(t *testing.T) {
+	s := setupSettle(t, 20, 0, 0)
+	s.enqueue(10, 0)
+	s.wantBatch(0, 1)
+}
