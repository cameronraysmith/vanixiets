+async def test_gated_reuse_reports_effects_on_reusing_commit(
+    pool: asyncpg.Pool,
+    make_env: EnvFactory,
+    upstream: Path,
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    """A merge-queue batch commit reusing a PR build (identical tree)
+    is gated like the PR. Its nixbot/effects must land on the batch
+    SHA, not on the PR head the build recorded, or a queue requiring
+    nixbot/effects waits on the batch forever."""
+    patch_effects(monkeypatch)
+    add_commit(upstream, "gated-batch")
+    pr_sha = git(upstream, "rev-parse", "HEAD")
+    orchestrator, reporter, project = await make_env(
+        FakeEvalRunner([mk_job("a")]), FakeExecutor(), name="gated-batch"
+    )
+    build = await orchestrator.handle_change_event(
+        ChangeEvent(repo=project, branch="main", commit_sha=pr_sha, pr_number=5)
+    )
+    assert build is not None
+    await drain_effect_items(orchestrator, project, pool)
+
+    git(upstream, "commit", "--allow-empty", "-m", "batch")
+    batch_sha = git(upstream, "rev-parse", "HEAD")
+    reporter.events.clear()
+    reused = await orchestrator.handle_change_event(
+        ChangeEvent(repo=project, branch="gitea-mq/batch/1", commit_sha=batch_sha)
+    )
+    assert reused is not None
+    assert reused.id_ == build.id_
+    await drain_effect_items(orchestrator, project, pool)
+
+    summaries = [e for e in reporter.events if e[0] == "effects-finished"]
+    assert any(e[2] == 0 and e[-1] == batch_sha for e in summaries)
+
+
