Post the settled effects summary to a gated commit reusing a gated build.

A merge-queue batch reusing its PR build otherwise never receives
nixbot/effects: effect items report on the recorded ref, which a gated
ref never replaces.

diff --git a/nixbot/after_build.py b/nixbot/after_build.py
index f3309bda..1b48f392 100644
--- a/nixbot/after_build.py
+++ b/nixbot/after_build.py
@@ -77,6 +77,12 @@ async def _effects(  # noqa: PLR0913
         await replay_effect_statuses(o, event, build)
         return
     await o.maybe_run_effects(event, build, worktree_path, credentials)
+    if reused:
+        # Effect items report on the build's recorded ref, which a gated
+        # ref never replaces. A gated commit reusing a gated build (a
+        # merge-queue batch reusing its PR build) gets the settled summary
+        # here or never; while checks still run, this posts nothing.
+        await o.post_effects_summary(event, build)
 
 
