{
  "kind": "Dashboard",
  "metadata": {
    "name": "devloop",
    "project": "fleet"
  },
  "spec": {
    "display": {
      "name": "Dev loop",
      "description": "Queue wait, batch formation to landing, attribute outcomes, deploys and nixbot evaluations from the devloop database, beside the evaluation host's memory budget."
    },
    "duration": "7d",
    "variables": [],
    "panels": {
      "queue-wait": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Pull-request CI queue wait",
            "description": "Seconds from a build's creation to its start, over each build's first attempt, per day: p50, p90 and p99."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "yAxis": {
                "format": {
                  "unit": "seconds"
                }
              },
              "legend": {
                "position": "bottom",
                "mode": "list"
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "GreptimeDBTimeSeriesQuery",
                  "spec": {
                    "datasource": {
                      "kind": "GreptimeDBDatasource",
                      "name": "greptimedb-sql"
                    },
                    "query": "SELECT date_bin(INTERVAL '1 day', c.\"finished_at\") AS \"ts\",\n       percentile_cont(CAST(CAST(c.\"started_at\" AS BIGINT) - CAST(c.\"created_at\" AS BIGINT) AS DOUBLE) / 1000000.0, 0.5) AS \"p50_s\"\nFROM \"devloop\".\"ci_build\" AS c\nJOIN (SELECT \"build_id\", min(\"finished_at\") AS \"first_finished\" FROM \"devloop\".\"ci_build\" GROUP BY \"build_id\") AS f\n  ON c.\"build_id\" = f.\"build_id\" AND c.\"finished_at\" = f.\"first_finished\"\nWHERE c.\"pr_number\" IS NOT NULL\n  AND c.\"started_at\" IS NOT NULL\n  AND c.\"created_at\" IS NOT NULL\n  AND c.\"finished_at\" BETWEEN to_timestamp_millis($__from) AND to_timestamp_millis($__to)\nGROUP BY 1\nORDER BY 1"
                  }
                }
              }
            },
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "GreptimeDBTimeSeriesQuery",
                  "spec": {
                    "datasource": {
                      "kind": "GreptimeDBDatasource",
                      "name": "greptimedb-sql"
                    },
                    "query": "SELECT date_bin(INTERVAL '1 day', c.\"finished_at\") AS \"ts\",\n       percentile_cont(CAST(CAST(c.\"started_at\" AS BIGINT) - CAST(c.\"created_at\" AS BIGINT) AS DOUBLE) / 1000000.0, 0.9) AS \"p90_s\"\nFROM \"devloop\".\"ci_build\" AS c\nJOIN (SELECT \"build_id\", min(\"finished_at\") AS \"first_finished\" FROM \"devloop\".\"ci_build\" GROUP BY \"build_id\") AS f\n  ON c.\"build_id\" = f.\"build_id\" AND c.\"finished_at\" = f.\"first_finished\"\nWHERE c.\"pr_number\" IS NOT NULL\n  AND c.\"started_at\" IS NOT NULL\n  AND c.\"created_at\" IS NOT NULL\n  AND c.\"finished_at\" BETWEEN to_timestamp_millis($__from) AND to_timestamp_millis($__to)\nGROUP BY 1\nORDER BY 1"
                  }
                }
              }
            },
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "GreptimeDBTimeSeriesQuery",
                  "spec": {
                    "datasource": {
                      "kind": "GreptimeDBDatasource",
                      "name": "greptimedb-sql"
                    },
                    "query": "SELECT date_bin(INTERVAL '1 day', c.\"finished_at\") AS \"ts\",\n       percentile_cont(CAST(CAST(c.\"started_at\" AS BIGINT) - CAST(c.\"created_at\" AS BIGINT) AS DOUBLE) / 1000000.0, 0.99) AS \"p99_s\"\nFROM \"devloop\".\"ci_build\" AS c\nJOIN (SELECT \"build_id\", min(\"finished_at\") AS \"first_finished\" FROM \"devloop\".\"ci_build\" GROUP BY \"build_id\") AS f\n  ON c.\"build_id\" = f.\"build_id\" AND c.\"finished_at\" = f.\"first_finished\"\nWHERE c.\"pr_number\" IS NOT NULL\n  AND c.\"started_at\" IS NOT NULL\n  AND c.\"created_at\" IS NOT NULL\n  AND c.\"finished_at\" BETWEEN to_timestamp_millis($__from) AND to_timestamp_millis($__to)\nGROUP BY 1\nORDER BY 1"
                  }
                }
              }
            }
          ]
        }
      },
      "formation-to-land": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Batch formation to landing",
            "description": "Seconds from a merge-queue batch's formation to its completion, at completion."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "yAxis": {
                "format": {
                  "unit": "seconds"
                }
              },
              "legend": {
                "position": "bottom",
                "mode": "list"
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "GreptimeDBTimeSeriesQuery",
                  "spec": {
                    "datasource": {
                      "kind": "GreptimeDBDatasource",
                      "name": "greptimedb-sql"
                    },
                    "query": "SELECT d.\"ts\" AS \"ts\",\n       CAST(CAST(d.\"ts\" AS BIGINT) - CAST(f.\"ts\" AS BIGINT) AS DOUBLE) / 1000000.0 AS \"formation_to_land_s\"\nFROM \"devloop\".\"batch_event\" AS f\nJOIN \"devloop\".\"batch_event\" AS d ON d.\"batch\" = f.\"batch\"\nWHERE f.\"msg\" = 'batch formed'\n  AND d.\"msg\" = 'batch done'\n  AND d.\"ts\" BETWEEN to_timestamp_millis($__from) AND to_timestamp_millis($__to)\nORDER BY 1"
                  }
                }
              }
            }
          ]
        }
      },
      "build-outcomes": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Attribute outcomes per day",
            "description": "Evaluated attributes per day by nixbot status."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "yAxis": {
                "format": {
                  "unit": "decimal"
                }
              },
              "legend": {
                "position": "bottom",
                "mode": "list"
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "GreptimeDBTimeSeriesQuery",
                  "spec": {
                    "datasource": {
                      "kind": "GreptimeDBDatasource",
                      "name": "greptimedb-sql"
                    },
                    "query": "SELECT date_bin(INTERVAL '1 day', \"finished_at\") AS \"ts\",\n       count(*) AS \"attributes\",\n       \"status\" AS \"status\"\nFROM \"devloop\".\"ci_attribute\"\nWHERE \"finished_at\" BETWEEN to_timestamp_millis($__from) AND to_timestamp_millis($__to)\nGROUP BY 1, 3\nORDER BY 1"
                  }
                }
              }
            }
          ]
        }
      },
      "deploys": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Deploys",
            "description": "One point per recorded deploy, by host."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "yAxis": {
                "format": {
                  "unit": "decimal"
                }
              },
              "legend": {
                "position": "bottom",
                "mode": "list"
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "GreptimeDBTimeSeriesQuery",
                  "spec": {
                    "datasource": {
                      "kind": "GreptimeDBDatasource",
                      "name": "greptimedb-sql"
                    },
                    "query": "SELECT \"ts\" AS \"ts\",\n       1 AS \"n\",\n       \"host\" AS \"host\"\nFROM \"devloop\".\"deploy_record\"\nWHERE \"ts\" BETWEEN to_timestamp_millis($__from) AND to_timestamp_millis($__to)\nORDER BY 1"
                  }
                }
              }
            }
          ]
        }
      },
      "evaluation-memory": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "nixbot evaluation memory",
            "description": "Each evaluation's memory peak by evaluator, against its memory ceiling and nixbot's 20 GiB throttle level (devloop.eval_run)."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "yAxis": {
                "format": {
                  "unit": "bytes"
                }
              },
              "legend": {
                "position": "bottom",
                "mode": "list"
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "GreptimeDBTimeSeriesQuery",
                  "spec": {
                    "datasource": {
                      "kind": "GreptimeDBDatasource",
                      "name": "greptimedb-sql"
                    },
                    "query": "SELECT \"ts\" AS \"ts\",\n       \"memory_peak_bytes\" AS \"memory_peak_bytes\",\n       \"evaluator\" AS \"evaluator\"\nFROM \"devloop\".\"eval_run\"\nWHERE \"memory_peak_bytes\" IS NOT NULL\n  AND \"ts\" BETWEEN to_timestamp_millis($__from) AND to_timestamp_millis($__to)\nORDER BY 1"
                  }
                }
              }
            },
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "GreptimeDBTimeSeriesQuery",
                  "spec": {
                    "datasource": {
                      "kind": "GreptimeDBDatasource",
                      "name": "greptimedb-sql"
                    },
                    "query": "SELECT \"ts\" AS \"ts\",\n       \"memory_max_bytes\" AS \"memory_ceiling_bytes\"\nFROM \"devloop\".\"eval_run\"\nWHERE \"memory_max_bytes\" IS NOT NULL\n  AND \"ts\" BETWEEN to_timestamp_millis($__from) AND to_timestamp_millis($__to)\nORDER BY 1"
                  }
                }
              }
            },
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "GreptimeDBTimeSeriesQuery",
                  "spec": {
                    "datasource": {
                      "kind": "GreptimeDBDatasource",
                      "name": "greptimedb-sql"
                    },
                    "query": "SELECT \"ts\" AS \"ts\",\n       21474836480 AS \"throttle_20GiB\"\nFROM \"devloop\".\"eval_run\"\nWHERE \"ts\" BETWEEN to_timestamp_millis($__from) AND to_timestamp_millis($__to)\nORDER BY 1"
                  }
                }
              }
            }
          ]
        }
      },
      "evaluation-wall-time": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "nixbot evaluation wall time",
            "description": "Each evaluation's wall time by evaluator (devloop.eval_run)."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "yAxis": {
                "format": {
                  "unit": "seconds"
                }
              },
              "legend": {
                "position": "bottom",
                "mode": "list"
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "GreptimeDBTimeSeriesQuery",
                  "spec": {
                    "datasource": {
                      "kind": "GreptimeDBDatasource",
                      "name": "greptimedb-sql"
                    },
                    "query": "SELECT \"ts\" AS \"ts\",\n       CAST(\"wall_ms\" AS DOUBLE) / 1000.0 AS \"wall_s\",\n       \"evaluator\" AS \"evaluator\"\nFROM \"devloop\".\"eval_run\"\nWHERE \"wall_ms\" IS NOT NULL\n  AND \"ts\" BETWEEN to_timestamp_millis($__from) AND to_timestamp_millis($__to)\nORDER BY 1"
                  }
                }
              }
            }
          ]
        }
      },
      "memory-budget": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Evaluation host memory budget",
            "description": "On the host nixbot evaluates on: each listed unit's memory, the system and user slices' totals, ZFS ARC and its limit, the RAM zram uses, and available memory."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "yAxis": {
                "format": {
                  "unit": "bytes"
                }
              },
              "legend": {
                "position": "bottom",
                "mode": "list"
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "datasource": {
                      "kind": "PrometheusDatasource",
                      "name": "greptimedb-promql"
                    },
                    "query": "sum by (host_name, unit) (vanixiets_unit_memory_current_bytes)",
                    "seriesNameFormat": "{{host_name}} {{unit}}"
                  }
                }
              }
            },
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "datasource": {
                      "kind": "PrometheusDatasource",
                      "name": "greptimedb-promql"
                    },
                    "query": "sum by (host_name) (node_zfs_arc_size) and on (host_name) sum by (host_name) (vanixiets_zram_mem_used_bytes)",
                    "seriesNameFormat": "{{host_name}} ZFS ARC"
                  }
                }
              }
            },
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "datasource": {
                      "kind": "PrometheusDatasource",
                      "name": "greptimedb-promql"
                    },
                    "query": "sum by (host_name) (node_zfs_arc_c_max) and on (host_name) sum by (host_name) (vanixiets_zram_mem_used_bytes)",
                    "seriesNameFormat": "{{host_name}} ZFS ARC limit"
                  }
                }
              }
            },
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "datasource": {
                      "kind": "PrometheusDatasource",
                      "name": "greptimedb-promql"
                    },
                    "query": "sum by (host_name) (vanixiets_zram_mem_used_bytes)",
                    "seriesNameFormat": "{{host_name}} zram RAM"
                  }
                }
              }
            },
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "datasource": {
                      "kind": "PrometheusDatasource",
                      "name": "greptimedb-promql"
                    },
                    "query": "sum by (host_name) (system_linux_memory_available_bytes) and on (host_name) sum by (host_name) (vanixiets_zram_mem_used_bytes)",
                    "seriesNameFormat": "{{host_name}} available"
                  }
                }
              }
            }
          ]
        }
      }
    },
    "layouts": [
      {
        "kind": "Grid",
        "spec": {
          "display": {
            "title": "Dev loop",
            "collapse": {
              "open": true
            }
          },
          "items": [
            {
              "x": 0,
              "y": 0,
              "width": 12,
              "height": 8,
              "content": {
                "$ref": "#/spec/panels/queue-wait"
              }
            },
            {
              "x": 12,
              "y": 0,
              "width": 12,
              "height": 8,
              "content": {
                "$ref": "#/spec/panels/formation-to-land"
              }
            },
            {
              "x": 0,
              "y": 8,
              "width": 12,
              "height": 8,
              "content": {
                "$ref": "#/spec/panels/build-outcomes"
              }
            },
            {
              "x": 12,
              "y": 8,
              "width": 12,
              "height": 8,
              "content": {
                "$ref": "#/spec/panels/deploys"
              }
            },
            {
              "x": 0,
              "y": 16,
              "width": 12,
              "height": 8,
              "content": {
                "$ref": "#/spec/panels/evaluation-memory"
              }
            },
            {
              "x": 12,
              "y": 16,
              "width": 12,
              "height": 8,
              "content": {
                "$ref": "#/spec/panels/evaluation-wall-time"
              }
            },
            {
              "x": 0,
              "y": 24,
              "width": 24,
              "height": 8,
              "content": {
                "$ref": "#/spec/panels/memory-budget"
              }
            }
          ]
        }
      }
    ]
  }
}
