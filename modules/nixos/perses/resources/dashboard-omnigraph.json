{
  "kind": "Dashboard",
  "metadata": {
    "name": "omnigraph",
    "project": "fleet"
  },
  "spec": {
    "display": {
      "name": "OmniGraph",
      "description": "omnigraph-server as omnigraph-probe sees it every minute: readiness, whether its graphs could be read, graphs by state, start time, each graph's entities, version and storage format, the local root's dataset against its quota and its snapshots, the graph backup's age, lock recoveries, and the server's memory."
    },
    "duration": "1d",
    "refreshInterval": "1m",
    "variables": [
      {
        "kind": "ListVariable",
        "spec": {
          "name": "host_name",
          "display": {
            "name": "Host"
          },
          "allowMultiple": true,
          "allowAllValue": true,
          "defaultValue": "$__all",
          "plugin": {
            "kind": "PrometheusLabelValuesVariable",
            "spec": {
              "datasource": {
                "kind": "PrometheusDatasource",
                "name": "greptimedb-promql"
              },
              "labelName": "host_name",
              "matchers": [
                "vanixiets_omnigraph_ready"
              ]
            }
          }
        }
      }
    ],
    "panels": {
      "ready": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Ready",
            "description": "Whether omnigraph-server's /readyz answered ready at the probe's last reading: serving at 1, not serving at 0 while it answers not ready or nothing answers; OmnigraphNotServing fires after 5 min at 0. The line under the value is the series over the view's range."
          },
          "plugin": {
            "kind": "StatChart",
            "spec": {
              "calculation": "last",
              "format": {
                "unit": "decimal"
              },
              "sparkline": {},
              "mappings": [
                {
                  "kind": "Value",
                  "spec": {
                    "value": "1",
                    "result": {
                      "value": "serving",
                      "color": "#2e7d32"
                    }
                  }
                },
                {
                  "kind": "Value",
                  "spec": {
                    "value": "0",
                    "result": {
                      "value": "not serving",
                      "color": "#c62828"
                    }
                  }
                }
              ]
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "datasource": {
                      "kind": "PrometheusDatasource",
                      "name": "greptimedb-promql"
                    },
                    "query": "max by (host_name) (vanixiets_omnigraph_ready{host_name=~\"$host_name\"})",
                    "seriesNameFormat": "{{host_name}}"
                  }
                }
              }
            }
          ]
        }
      },
      "graph-reads": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Graph reads",
            "description": "Whether the probe's last reading listed the graphs with GET /graphs and read every ready graph's snapshot with the monitor token: reading at 1, failing at 0 when a request is refused or fails (each one a journal line of omnigraph-probe.service with its HTTP status) or the server does not answer /readyz. The line under the value is the series over the view's range."
          },
          "plugin": {
            "kind": "StatChart",
            "spec": {
              "calculation": "last",
              "format": {
                "unit": "decimal"
              },
              "sparkline": {},
              "mappings": [
                {
                  "kind": "Value",
                  "spec": {
                    "value": "1",
                    "result": {
                      "value": "reading",
                      "color": "#2e7d32"
                    }
                  }
                },
                {
                  "kind": "Value",
                  "spec": {
                    "value": "0",
                    "result": {
                      "value": "failing",
                      "color": "#c62828"
                    }
                  }
                }
              ]
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "datasource": {
                      "kind": "PrometheusDatasource",
                      "name": "greptimedb-promql"
                    },
                    "query": "min by (host_name) (vanixiets_omnigraph_graph_reads_ok{host_name=~\"$host_name\"})",
                    "seriesNameFormat": "{{host_name}}"
                  }
                }
              }
            }
          ]
        }
      },
      "graph-states": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Graphs by state",
            "description": "Graphs omnigraph-server serves, and how many of them are ready, loading or blocked, from /readyz; OmnigraphNotServing fires after 5 min with any blocked."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "yAxis": {
                "format": {
                  "unit": "decimal"
                }
              },
              "legend": {
                "position": "bottom",
                "mode": "list"
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "datasource": {
                      "kind": "PrometheusDatasource",
                      "name": "greptimedb-promql"
                    },
                    "query": "sum by (host_name, state) (vanixiets_omnigraph_graphs{host_name=~\"$host_name\"})",
                    "seriesNameFormat": "{{host_name}} {{state}}"
                  }
                }
              }
            }
          ]
        }
      },
      "start-to-ready": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Start to ready",
            "description": "Seconds from omnigraph-server's main process start to the end of its start job, which waits for readiness, for the current run."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "yAxis": {
                "format": {
                  "unit": "seconds"
                }
              },
              "legend": {
                "position": "bottom",
                "mode": "list"
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "datasource": {
                      "kind": "PrometheusDatasource",
                      "name": "greptimedb-promql"
                    },
                    "query": "max by (host_name) (vanixiets_omnigraph_start_to_ready_seconds{host_name=~\"$host_name\"})",
                    "seriesNameFormat": "{{host_name}}"
                  }
                }
              }
            }
          ]
        }
      },
      "graph-entities": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Entities per graph",
            "description": "Entities in each ready graph's main branch, summed over its datasets, read as the monitor actor; a graph whose read failed has no point. The legend names each graph without its cookbook- prefix, after the host serving it, with its last value."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "yAxis": {
                "format": {
                  "unit": "decimal"
                }
              },
              "legend": {
                "position": "right",
                "mode": "table",
                "size": "small",
                "values": [
                  "last"
                ]
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "datasource": {
                      "kind": "PrometheusDatasource",
                      "name": "greptimedb-promql"
                    },
                    "query": "label_replace(sum by (host_name, graph) (vanixiets_omnigraph_graph_entities{host_name=~\"$host_name\"}), \"graph_name\", \"$1\", \"graph\", \"(?:cookbook-)?(.*)\")",
                    "seriesNameFormat": "{{host_name}} {{graph_name}}"
                  }
                }
              }
            }
          ]
        }
      },
      "graph-versions": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Manifest version and storage format per graph",
            "description": "At the end of the view's range, each ready graph's main branch: its graph manifest version, which rises with every commit, and the storage format (internal schema version) it is stamped at."
          },
          "plugin": {
            "kind": "Table",
            "spec": {
              "density": "compact",
              "defaultColumnHidden": true,
              "enableSorting": true,
              "columnSettings": [
                {
                  "name": "graph",
                  "header": "Graph",
                  "sort": "asc"
                },
                {
                  "name": "host_name",
                  "header": "Host"
                },
                {
                  "name": "value #1",
                  "header": "Manifest version",
                  "format": {
                    "unit": "decimal",
                    "decimalPlaces": 0,
                    "shortValues": false
                  }
                },
                {
                  "name": "value #2",
                  "header": "Storage format",
                  "format": {
                    "unit": "decimal",
                    "decimalPlaces": 0,
                    "shortValues": false
                  }
                }
              ],
              "transforms": [
                {
                  "kind": "MergeIndexedColumns",
                  "spec": {
                    "column": "host_name"
                  }
                },
                {
                  "kind": "MergeIndexedColumns",
                  "spec": {
                    "column": "graph"
                  }
                },
                {
                  "kind": "JoinByColumnValue",
                  "spec": {
                    "columns": [
                      "host_name",
                      "graph"
                    ]
                  }
                }
              ]
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "datasource": {
                      "kind": "PrometheusDatasource",
                      "name": "greptimedb-promql"
                    },
                    "query": "max by (host_name, graph) (vanixiets_omnigraph_graph_manifest_version{host_name=~\"$host_name\"})"
                  }
                }
              }
            },
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "datasource": {
                      "kind": "PrometheusDatasource",
                      "name": "greptimedb-promql"
                    },
                    "query": "max by (host_name, graph) (vanixiets_omnigraph_graph_storage_format{host_name=~\"$host_name\"})"
                  }
                }
              }
            }
          ]
        }
      },
      "dataset-quota-used": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Dataset quota used",
            "description": "Bytes used by the ZFS dataset holding a local root, snapshots included, over its quota; a dataset without a quota has no point. Written only while the host serves a local root."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "yAxis": {
                "format": {
                  "unit": "percent-decimal"
                }
              },
              "legend": {
                "position": "bottom",
                "mode": "list"
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "datasource": {
                      "kind": "PrometheusDatasource",
                      "name": "greptimedb-promql"
                    },
                    "query": "max by (host_name) (vanixiets_omnigraph_dataset_used_bytes{host_name=~\"$host_name\"}) / (max by (host_name) (vanixiets_omnigraph_dataset_quota_bytes{host_name=~\"$host_name\"}) > 0)",
                    "seriesNameFormat": "{{host_name}}"
                  }
                }
              }
            }
          ]
        }
      },
      "dataset-usage": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Dataset used and quota",
            "description": "Bytes used by the ZFS dataset holding a local root, snapshots included, and its quota (0 for none) at the probe's last reading, each with its series over the view's range; written only while the host serves a local root."
          },
          "plugin": {
            "kind": "StatChart",
            "spec": {
              "calculation": "last",
              "format": {
                "unit": "bytes"
              },
              "sparkline": {}
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "datasource": {
                      "kind": "PrometheusDatasource",
                      "name": "greptimedb-promql"
                    },
                    "query": "max by (host_name) (vanixiets_omnigraph_dataset_used_bytes{host_name=~\"$host_name\"})",
                    "seriesNameFormat": "{{host_name}} used"
                  }
                }
              }
            },
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "datasource": {
                      "kind": "PrometheusDatasource",
                      "name": "greptimedb-promql"
                    },
                    "query": "max by (host_name) (vanixiets_omnigraph_dataset_quota_bytes{host_name=~\"$host_name\"})",
                    "seriesNameFormat": "{{host_name}} quota"
                  }
                }
              }
            }
          ]
        }
      },
      "dataset-snapshots": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Local snapshots",
            "description": "Snapshots of the dataset holding a local root; written only while the host serves a local root."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "yAxis": {
                "format": {
                  "unit": "decimal"
                }
              },
              "legend": {
                "position": "bottom",
                "mode": "list"
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "datasource": {
                      "kind": "PrometheusDatasource",
                      "name": "greptimedb-promql"
                    },
                    "query": "max by (host_name) (vanixiets_omnigraph_dataset_snapshots{host_name=~\"$host_name\"})",
                    "seriesNameFormat": "{{host_name}}"
                  }
                }
              }
            }
          ]
        }
      },
      "backup-age": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Graph backup age",
            "description": "Seconds since the last nightly graph backup whose backup, prune and check all succeeded; written only where the graph backup is on."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "yAxis": {
                "format": {
                  "unit": "seconds"
                }
              },
              "legend": {
                "position": "bottom",
                "mode": "list"
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "datasource": {
                      "kind": "PrometheusDatasource",
                      "name": "greptimedb-promql"
                    },
                    "query": "time() - max by (host_name) (vanixiets_omnigraph_backup_last_success_timestamp_seconds{host_name=~\"$host_name\"})",
                    "seriesNameFormat": "{{host_name}}"
                  }
                }
              }
            }
          ]
        }
      },
      "lock-recoveries": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Lock recoveries",
            "description": "Stale serve locks omnigraph-server's start has cleared on this host, shown in orange once any has been; each recovery is an omnigraph-lock-recovery line in omnigraph-server's journal. Written only while the host serves a local root."
          },
          "plugin": {
            "kind": "StatChart",
            "spec": {
              "calculation": "last",
              "format": {
                "unit": "decimal"
              },
              "sparkline": {},
              "thresholds": {
                "mode": "absolute",
                "defaultColor": "#2e7d32",
                "steps": [
                  {
                    "value": 1,
                    "color": "#ef6c00"
                  }
                ]
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "datasource": {
                      "kind": "PrometheusDatasource",
                      "name": "greptimedb-promql"
                    },
                    "query": "max by (host_name) (vanixiets_omnigraph_lock_recoveries_total{host_name=~\"$host_name\"})",
                    "seriesNameFormat": "{{host_name}}"
                  }
                }
              }
            }
          ]
        }
      },
      "server-memory": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "omnigraph-server memory",
            "description": "omnigraph-server.service's current and peak memory, from the host's memory budget probe."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "yAxis": {
                "format": {
                  "unit": "bytes"
                }
              },
              "legend": {
                "position": "bottom",
                "mode": "list"
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "datasource": {
                      "kind": "PrometheusDatasource",
                      "name": "greptimedb-promql"
                    },
                    "query": "max by (host_name) (vanixiets_unit_memory_current_bytes{unit=\"omnigraph-server.service\", host_name=~\"$host_name\"})",
                    "seriesNameFormat": "{{host_name}} current"
                  }
                }
              }
            },
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "datasource": {
                      "kind": "PrometheusDatasource",
                      "name": "greptimedb-promql"
                    },
                    "query": "max by (host_name) (vanixiets_unit_memory_peak_bytes{unit=\"omnigraph-server.service\", host_name=~\"$host_name\"})",
                    "seriesNameFormat": "{{host_name}} peak"
                  }
                }
              }
            }
          ]
        }
      }
    },
    "layouts": [
      {
        "kind": "Grid",
        "spec": {
          "display": {
            "title": "Serving",
            "collapse": {
              "open": true
            }
          },
          "items": [
            {
              "x": 0,
              "y": 0,
              "width": 4,
              "height": 8,
              "content": {
                "$ref": "#/spec/panels/ready"
              }
            },
            {
              "x": 4,
              "y": 0,
              "width": 4,
              "height": 8,
              "content": {
                "$ref": "#/spec/panels/graph-reads"
              }
            },
            {
              "x": 8,
              "y": 0,
              "width": 8,
              "height": 8,
              "content": {
                "$ref": "#/spec/panels/graph-states"
              }
            },
            {
              "x": 16,
              "y": 0,
              "width": 8,
              "height": 8,
              "content": {
                "$ref": "#/spec/panels/start-to-ready"
              }
            }
          ]
        }
      },
      {
        "kind": "Grid",
        "spec": {
          "display": {
            "title": "Graphs",
            "collapse": {
              "open": true
            }
          },
          "items": [
            {
              "x": 0,
              "y": 0,
              "width": 14,
              "height": 12,
              "content": {
                "$ref": "#/spec/panels/graph-entities"
              }
            },
            {
              "x": 14,
              "y": 0,
              "width": 10,
              "height": 12,
              "content": {
                "$ref": "#/spec/panels/graph-versions"
              }
            }
          ]
        }
      },
      {
        "kind": "Grid",
        "spec": {
          "display": {
            "title": "Storage and recovery",
            "collapse": {
              "open": true
            }
          },
          "items": [
            {
              "x": 0,
              "y": 0,
              "width": 6,
              "height": 8,
              "content": {
                "$ref": "#/spec/panels/dataset-quota-used"
              }
            },
            {
              "x": 6,
              "y": 0,
              "width": 5,
              "height": 8,
              "content": {
                "$ref": "#/spec/panels/dataset-usage"
              }
            },
            {
              "x": 11,
              "y": 0,
              "width": 5,
              "height": 8,
              "content": {
                "$ref": "#/spec/panels/dataset-snapshots"
              }
            },
            {
              "x": 16,
              "y": 0,
              "width": 4,
              "height": 8,
              "content": {
                "$ref": "#/spec/panels/backup-age"
              }
            },
            {
              "x": 20,
              "y": 0,
              "width": 4,
              "height": 8,
              "content": {
                "$ref": "#/spec/panels/lock-recoveries"
              }
            }
          ]
        }
      },
      {
        "kind": "Grid",
        "spec": {
          "display": {
            "title": "Memory",
            "collapse": {
              "open": true
            }
          },
          "items": [
            {
              "x": 0,
              "y": 0,
              "width": 24,
              "height": 8,
              "content": {
                "$ref": "#/spec/panels/server-memory"
              }
            }
          ]
        }
      }
    ]
  }
}
