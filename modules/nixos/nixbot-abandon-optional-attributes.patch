+class TimedExecutor:
+    """Builds take `delays[attr]` seconds; attrs in `hang` run until
+    abandoned. Abandoning ends a build as abandoned, as the
+    orchestrator's executor does."""
+
+    def __init__(
+        self, delays: dict[str, float] | None = None, hang: set[str] | None = None
+    ) -> None:
+        self.delays = delays or {}
+        self.hang = hang or set()
+        self.stops: dict[str, asyncio.Event] = {}
+        self.abandoned: list[str] = []
+
+    def abandon(self, job: NixEvalJobSuccess) -> None:
+        self.abandoned.append(job.attr)
+        self.stops.setdefault(job.attr, asyncio.Event()).set()
+
+    async def build(self, job: NixEvalJobSuccess) -> BuildOutcome:
+        stop = self.stops.setdefault(job.attr, asyncio.Event())
+        if job.attr in self.hang:
+            await stop.wait()
+        else:
+            try:
+                await asyncio.wait_for(stop.wait(), self.delays.get(job.attr, 0))
+            except TimeoutError:
+                return BuildOutcome.success
+        return BuildOutcome.abandoned
+
+
+def _optional(attr: str, deps: list[str] | None = None) -> NixEvalJobSuccess:
+    return _with_extra(mk_job(attr, deps=deps or []), ignoreFailure=True)
+
+
+async def test_optional_job_within_grace_ends_build_when_it_finishes() -> None:
+    # The grace is a ceiling, not a wait: the build ends with the
+    # optional job, long before the grace would expire.
+    grace = 30.0
+    executor = TimedExecutor({"opt": 0.05})
+    scheduler = JobScheduler(
+        executor,
+        [SYSTEM],
+        abandon_optional=AbandonOptional(grace=grace, abandon=executor.abandon),
+    )
+    loop = asyncio.get_running_loop()
+    start = loop.time()
+    result = await run_scheduler(scheduler, [mk_job("req"), _optional("opt")])
+    assert loop.time() - start < grace
+    statuses = by_attr(result)
+    assert statuses["req"] == AttributeStatus.succeeded
+    assert statuses["opt"] == AttributeStatus.succeeded
+    assert executor.abandoned == []
+
+
+async def test_optional_jobs_unfinished_after_grace_are_abandoned() -> None:
+    executor = TimedExecutor(hang={"opt"})
+    scheduler = JobScheduler(
+        executor,
+        [SYSTEM],
+        abandon_optional=AbandonOptional(grace=0.05, abandon=executor.abandon),
+    )
+    result = await asyncio.wait_for(
+        run_scheduler(
+            scheduler, [mk_job("req"), _optional("opt"), _optional("top", ["opt"])]
+        ),
+        timeout=5,
+    )
+    statuses = by_attr(result)
+    assert statuses["req"] == AttributeStatus.succeeded
+    assert statuses["opt"] == AttributeStatus.ignored_failure
+    assert statuses["top"] == AttributeStatus.ignored_failure
+    assert executor.abandoned == ["opt"]
+    errors = {r.attr: r.error for r in result.results}
+    assert errors["opt"] == "not finished when the required attributes had settled"
+    assert result.success
+
+
+async def test_grace_starts_when_the_required_jobs_have_settled() -> None:
+    # Counted from t=0 the grace would expire at 0.3 s, before the
+    # optional job finishes at 0.45 s; counted from the required job
+    # settling at 0.3 s it expires at 0.6 s, after it.
+    executor = TimedExecutor({"req": 0.3, "opt": 0.45})
+    scheduler = JobScheduler(
+        executor,
+        [SYSTEM],
+        abandon_optional=AbandonOptional(grace=0.3, abandon=executor.abandon),
+    )
+    result = await run_scheduler(scheduler, [mk_job("req"), _optional("opt")])
+    assert by_attr(result)["opt"] == AttributeStatus.succeeded
+    assert executor.abandoned == []
