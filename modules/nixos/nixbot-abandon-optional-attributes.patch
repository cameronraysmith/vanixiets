+async def test_unfinished_optional_attribute_is_abandoned_after_grace(
+    pool: asyncpg.Pool, run_event: EventRunner, upstream: Path
+) -> None:
+    """With optional_build_grace set, an ignoreFailure attribute still
+    running after the others settled is stopped and ignored: the build
+    succeeds instead of waiting for it."""
+    (upstream / "nixbot.toml").write_text("optional_build_grace = 0\n")
+    git(upstream, "add", ".")
+    git(upstream, "commit", "-m", "do not wait for optional attributes")
+    hung = mk_job("darwin").model_copy(update={"extra_value": {"ignoreFailure": True}})
+    build, _ = await asyncio.wait_for(
+        run_event(
+            FakeEvalRunner([mk_job("linux"), hung]), FakeExecutor(hang={"darwin"})
+        ),
+        timeout=30,
+    )
+    assert build is not None
+    row = await pool.fetchrow("SELECT status FROM builds WHERE id = $1", build.id_)
+    assert row["status"] == BuildStatus.SUCCEEDED
+    attrs = await pool.fetch(
+        "SELECT attr, status, error FROM build_attributes WHERE build_id = $1",
+        build.id_,
+    )
+    assert {r["attr"]: (r["status"], r["error"]) for r in attrs} == {
+        "linux": ("succeeded", None),
+        "darwin": (
+            "ignored_failure",
+            "not finished when the required attributes had settled",
+        ),
+    }
+
