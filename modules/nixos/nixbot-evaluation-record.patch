+# nix-eval-jobs' own stderr reports of a worker it killed for the
+# memory budget, and of a worker killed by something else (the kernel).
+BUDGET_KILL_PREFIX = "memory budget of"
+WORKER_KILL_MARKER = "was killed (system out of memory?)"
+
+
+@dataclass
+class EvalOutcome:
+    """What one evaluator run did, for its "evaluation finished" record.
+    exit_status stays None when the evaluator never started."""
+
+    exit_status: int | None = None
+    duration_ms: int | None = None
+    budget_kills: int = 0
+    worker_kills: int = 0
+
+    def count_kill(self, line: str) -> None:
+        if line.startswith(BUDGET_KILL_PREFIX):
+            self.budget_kills += 1
+        elif WORKER_KILL_MARKER in line:
+            self.worker_kills += 1
+
+
+def _read_int(path: Path) -> int | None:
+    try:
+        text = path.read_text().strip()
+    except OSError:
+        return None
+    return int(text) if text.isdigit() else None
+
+
+def _read_keyed(path: Path) -> dict[str, int]:
+    try:
+        lines = path.read_text().splitlines()
+    except OSError:
+        return {}
+    keyed: dict[str, int] = {}
+    for line in lines:
+        key, _, value = line.partition(" ")
+        if value.strip().isdigit():
+            keyed[key] = int(value)
+    return keyed
+
+
+def eval_cgroup_usage(eval_cgroup: Path) -> dict[str, int]:
+    """The evaluation cgroup's memory ceiling and peak, kernel OOM kills
+    and CPU time. A file the kernel does not provide is left out."""
+    usage: dict[str, int] = {}
+    memory_max = _read_int(eval_cgroup / "memory.max")
+    if memory_max is not None:
+        usage["memory_max_bytes"] = memory_max
+    memory_peak = _read_int(eval_cgroup / "memory.peak")
+    if memory_peak is not None:
+        usage["memory_peak_bytes"] = memory_peak
+    events = _read_keyed(eval_cgroup / "memory.events")
+    if "oom_kill" in events:
+        usage["oom_kill"] = events["oom_kill"]
+    cpu = _read_keyed(eval_cgroup / "cpu.stat")
+    if "user_usec" in cpu:
+        usage["user_ms"] = cpu["user_usec"] // 1000
+    if "system_usec" in cpu:
+        usage["system_ms"] = cpu["system_usec"] // 1000
+    return usage
+
+
+def log_evaluation_record(
+    settings: EvalSettings, outcome: EvalOutcome, eval_cgroup: Path | None
+) -> None:
+    """One structured line per evaluation. It carries no text from the
+    evaluator's output, so it can be stored as it is."""
+    if outcome.exit_status is None:
+        return
+    evaluator, _, version = (
+        os.environ.get("NIXBOT_EVALUATOR", "").strip().partition(" ")
+    )
+    record: dict[str, object] = {
+        "build_id": settings.build_id,
+        "evaluator": evaluator or "nix-eval-jobs",
+        "evaluator_version": version or None,
+        "workers": settings.worker_count,
+        "max_memory_mib": settings.max_memory_size_mib,
+        "wall_ms": outcome.duration_ms,
+        "budget_kills": outcome.budget_kills,
+        "worker_kills": outcome.worker_kills,
+        "exit_status": outcome.exit_status,
+    }
+    if eval_cgroup is not None:
+        record.update(eval_cgroup_usage(eval_cgroup))
+    logger.info("evaluation finished", extra=record)
+
+
