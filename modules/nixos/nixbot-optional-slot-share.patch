+class _Lane:
+    """Waiters of one priority class: round-robin across keys (builds),
+    FIFO within a key."""
+
+    def __init__(self) -> None:
+        # key -> FIFO of waiter futures; OrderedDict gives stable rotation.
+        self.waiters: OrderedDict[object, deque[asyncio.Future[None]]] = OrderedDict()
+        self.rotation: deque[object] = deque()
+
+    def __bool__(self) -> bool:
+        return bool(self.waiters)
+
+    def enqueue(self, key: object, future: asyncio.Future[None]) -> None:
+        if key not in self.waiters:
+            self.waiters[key] = deque()
+            self.rotation.append(key)
+        self.waiters[key].append(future)
+
+    def discard(self, key: object, future: asyncio.Future[None]) -> None:
+        queue = self.waiters.get(key)
+        if queue is not None and future in queue:
+            queue.remove(future)
+            if not queue:
+                del self.waiters[key]
+                self.rotation.remove(key)
+
+    def pop(self) -> asyncio.Future[None] | None:
+        """Next waiter, rotating to the next build; None when empty."""
+        while self.rotation:
+            key = self.rotation[0]
+            queue = self.waiters.get(key)
+            if not queue:
+                self.rotation.popleft()
+                self.waiters.pop(key, None)
+                continue
+            future = queue.popleft()
+            self.rotation.rotate(-1)
+            if not queue:
+                del self.waiters[key]
+                self.rotation.remove(key)
+            return future
+        return None
+
