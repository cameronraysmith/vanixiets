+async def test_fair_scheduler_serves_required_before_optional() -> None:
+    queue = FairScheduler(1)
+    order: list[str] = []
+    await queue.acquire("seed")
+
+    async def worker(name: str, key: str, *, optional: bool) -> None:
+        await queue.acquire(key, optional=optional)
+        order.append(name)
+        queue.release(optional=optional)
+
+    # The optional waiter queued first, from another build, still waits.
+    tasks = [
+        asyncio.create_task(worker("o1", "A", optional=True)),
+        asyncio.create_task(worker("r1", "B", optional=False)),
+        asyncio.create_task(worker("r2", "C", optional=False)),
+    ]
+    await asyncio.sleep(0)
+    queue.release()
+    await asyncio.gather(*tasks)
+    assert order == ["r1", "r2", "o1"]
+
+
+async def test_optional_jobs_cannot_starve_required_ones() -> None:
+    # Optional builds hung on an unreachable builder fill at most half
+    # the pool; required builds still get the rest immediately.
+    queue = FairScheduler(4)
+    hung = [
+        asyncio.create_task(queue.acquire(f"b{i}", optional=True)) for i in range(4)
+    ]
+    await asyncio.sleep(0)
+    assert sum(t.done() for t in hung) == 2
+    await asyncio.wait_for(queue.acquire("req"), timeout=1)
+    await asyncio.wait_for(queue.acquire("req"), timeout=1)
+    blocked = asyncio.create_task(queue.acquire("req"))
+    await asyncio.sleep(0)
+    assert not blocked.done()  # the pool is full, not reserved
+    queue.release(optional=True)
+    await asyncio.wait_for(blocked, timeout=1)  # required first
+    assert sum(t.done() for t in hung) == 2
+    for task in hung:
+        task.cancel()
+    await asyncio.gather(*hung, return_exceptions=True)
+
+
+async def test_cancelled_optional_waiter_returns_its_class_slot() -> None:
+    queue = FairScheduler(2)  # one optional slot
+    await queue.acquire("A", optional=True)
+    waiter = asyncio.create_task(queue.acquire("B", optional=True))
+    await asyncio.sleep(0)
+    waiter.cancel()
+    with pytest.raises(asyncio.CancelledError):
+        await waiter
+    queue.release(optional=True)
+    await asyncio.wait_for(queue.acquire("C", optional=True), timeout=1)
+
