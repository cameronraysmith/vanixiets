diff --git a/internal/batch/mirror_test.go b/internal/batch/mirror_test.go
new file mode 100644
index 0000000..5cc23ca
--- /dev/null
+++ b/internal/batch/mirror_test.go
@@ -0,0 +1,82 @@
+package batch_test
+
+import (
+	"context"
+	"slices"
+	"testing"
+
+	"github.com/Mic92/gitea-mq/internal/forge"
+	"github.com/Mic92/gitea-mq/internal/monitor"
+	"github.com/Mic92/gitea-mq/internal/store/pg"
+)
+
+// The poller applies one snapshot of merge-branch checks in map order. When
+// the last required check lands the batch before a still-running check is
+// applied, that check must not be mirrored as pending onto the PR head:
+// nothing updates the mirror once the PR has left the queue.
+func TestApplyCheck_NoMirrorAfterLanding(t *testing.T) {
+	for _, tc := range []struct {
+		name     string
+		prs      []int64
+		upToDate bool
+	}{
+		{"up-to-date singleton", []int64{10}, true},
+		{"two members", []int64{10, 20}, false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			e, f, svc, ctx := setup(t, tc.prs...)
+			for _, n := range tc.prs {
+				f.merged[n] = true
+			}
+			f.GetRequiredChecksFn = func(context.Context, string, string, string) ([]string, error) {
+				return []string{"ci"}, nil
+			}
+			if tc.upToDate {
+				e.SkipIfUpToDate = true
+				f.IsUpToDateFn = func(_ context.Context, _, _, _, head string) (bool, error) {
+					return head == "sha10", nil
+				}
+				f.FastForwardFn = func(_ context.Context, _, _, _, sha string) error {
+					f.target = sha
+					return nil
+				}
+			}
+			if _, err := e.FormAndBuild(ctx, "main"); err != nil {
+				t.Fatal(err)
+			}
+			rep, _ := svc.GetEntry(ctx, e.RepoID, 10)
+			deps := &monitor.Deps{Forge: f.MockForge, Queue: svc, Owner: e.Owner, Repo: e.Repo, RepoID: e.RepoID, Batch: e}
+
+			for _, c := range []struct {
+				name  string
+				state pg.CheckState
+			}{{"ci", pg.CheckStateSuccess}, {"docs-preview", pg.CheckStatePending}} {
+				if err := monitor.ApplyCheck(ctx, deps, rep, c.name, forge.Check{State: c.state}); err != nil {
+					t.Fatal(err)
+				}
+			}
+			if b, _ := svc.GetLiveBatch(ctx, e.RepoID, "main"); b != nil {
+				t.Fatalf("batch still live: %+v", b)
+			}
+
+			landed := false
+			var beforeLanding []string
+			for _, call := range f.Calls {
+				switch call.Method {
+				case "FastForward":
+					landed = true
+				case "MirrorCheck":
+					name, check := call.Args[3].(string), call.Args[4].(forge.Check)
+					if !landed {
+						beforeLanding = append(beforeLanding, name)
+					} else if check.State == pg.CheckStatePending {
+						t.Errorf("%s mirrored as pending after the batch landed", name)
+					}
+				}
+			}
+			if !slices.Equal(beforeLanding, []string{"gitea-mq/ci"}) {
+				t.Errorf("mirrored before landing = %v, want [gitea-mq/ci]", beforeLanding)
+			}
+		})
+	}
+}
