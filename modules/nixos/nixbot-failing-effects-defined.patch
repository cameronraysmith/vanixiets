+def test_failing_badge_counts_only_effects_still_defined(
+    client: WebHarness,
+) -> None:
+    """A renamed or removed effect never runs again, so its last failure
+    stops counting. The newest default-branch effects pass and the
+    current schedules say which effects the project defines."""
+    p = _FailingEffects(client, "failing-defined")
+    # Failures of effects since renamed and of a schedule since removed.
+    p.run(p.build(pr_number=1), "pull_request", "deploy-preview", "failed")
+    p.run(p.build(pr_number=1), "check", "push.deploy-old", "failed")
+    p.run(None, "schedule", "gc", "failed", "nightly")
+    main = p.build()
+    p.run(main, "push", "deploy", "succeeded")
+    p.run(main, "check", "pull_request.preview", "succeeded")
+    assert p.failing() == 0
+
+    # A current effect whose newest run failed counts, under its own
+    # trigger and as the check of a pull request.
+    p.run(p.build(pr_number=2), "pull_request", "preview", "failed")
+    assert p.failing() == 1
+    p.run(p.build(pr_number=2), "check", "push.deploy", "failed")
+    assert p.failing() == 2
+    p.run(p.build(pr_number=3), "check", "push.deploy", "succeeded")
+    # A newer default-branch pass whose onEvent definitions failed to
+    # evaluate lists no checks; the last good pass still defines them.
+    broken = p.build(eval_error="onEvent")
+    p.run(broken, "push", "deploy", "succeeded")
+    assert p.failing() == 1
