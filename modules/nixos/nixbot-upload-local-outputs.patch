+def enqueue_local_outputs(
+    uploaders: Sequence[Uploader],
+    event: ChangeEvent,
+    results: Sequence[AttributeResult],
+) -> None:
+    """Queue the outputs of the attributes found already in the store.
+
+    Skipping them assumed that an output in the local store was built
+    and uploaded by an earlier build, or substituted from the cache.
+    An output that reached the store another way (a remote build or a
+    developer's build on this host) was then never uploaded. Only for
+    pushes to the default branch, whose skipped outputs also get gcroots
+    (post_process_skipped): every change reaching it gets such a build.
+    Queued in one batch per build, so the uploader resolves them in one
+    call; an uploader that asks the cache which closures it has (niks3)
+    walks the closure only of the paths it lacks."""
+    if event.pr_number is not None or event.branch != event.repo.default_branch:
+        return
+    paths = [
+        path
+        for result in results
+        if result.status == AttributeStatus.skipped_local
+        and isinstance(result.job, NixEvalJobSuccess)
+        and not result.job.build_dependencies_only
+        for path in result.job.outputs.values()
+        if path
+    ]
+    for uploader in uploaders:
+        for path in paths:
+            uploader.enqueue_nowait(path)
+
+
