# flake.lib.zfsBootInvariants.<host>: the ZFS dataset properties a host
# enforces at boot, one entry per oneshot unit, in unit order:
#   { unit, dataset, property, value, when }
# `when` is null (always), "postgresqlBackup" (only with
# vanixiets.postgresqlBackup.enable) or "omnigraphLocalRoot" (only with
# vanixiets.omnigraphRootStore = "local"), the conditions under which the
# dataset exists.
#
# disko applies a dataset's options at creation only, so a property declared
# there is not re-asserted on an already-provisioned host by a deploy. The
# host's units issue `zfs set <property>=<value> <dataset>` at boot, which is
# a no-op when the value already matches. The host's disko.nix stays an
# independent statement of the install-time values, and
# checks.x86_64-linux.greptimedb-envelope compares the two for the telemetry
# store's dataset. The units are generated by the host's composition
# (machines/nixos/<host>/default.nix), the store's envelope variables are
# read from the greptimedb entries (nixos/greptimedb-server.nix), and the
# unit names are the host's notified units (lib/observability-hosts.nix).
{
  flake.lib.zfsBootInvariants.magnetite = [
    # Disko's `com.sun:auto-snapshot = "false"` on the reproducible-content
    # datasets (root/nix, root/docker, root/podman).
    {
      unit = "zfs-assert-root-nix-noautosnap";
      dataset = "zroot/root/nix";
      property = "com.sun:auto-snapshot";
      value = "false";
      when = null;
    }
    {
      unit = "zfs-assert-root-docker-noautosnap";
      dataset = "zroot/root/docker";
      property = "com.sun:auto-snapshot";
      value = "false";
      when = null;
    }
    {
      unit = "zfs-assert-root-podman-noautosnap";
      dataset = "zroot/root/podman";
      property = "com.sun:auto-snapshot";
      value = "false";
      when = null;
    }
    # Pool-starvation guardrails (2026-06-10 incident: /nix consumed the
    # entire 304G pool and wedged every dataset). The quota caps /nix below
    # pool capacity; the reservation guarantees / writable headroom even
    # when /nix hits its quota.
    {
      unit = "zfs-set-root-nix-quota";
      dataset = "zroot/root/nix";
      property = "quota";
      value = "250G";
      when = null;
    }
    # A reservation counts the dataset's own use, so it holds room for /
    # only by its margin over that use, and / uses over 15G. / is the
    # dataset whose exhaustion stops the host, and the other datasets'
    # quotas sum to more than the pool, so only a reservation guarantees
    # it room.
    {
      unit = "zfs-set-root-nixos-reservation";
      dataset = "zroot/root/nixos";
      property = "reservation";
      value = "25G";
      when = null;
    }
    # /home has no reservation: a reservation guarantees a total that
    # counts the dataset's own use, /home's use exceeded its former 4G, and
    # nothing on the host stops when /home cannot grow. A property set on
    # the installed pool stays until cleared, so this clears it.
    {
      unit = "zfs-set-root-home-noreservation";
      dataset = "zroot/root/home";
      property = "reservation";
      value = "none";
      when = null;
    }
    # The container engines' ZFS storage drivers create a child dataset per
    # image layer and container under these datasets. The bound is quota,
    # which counts descendants, not refquota, which would leave the layers
    # unbounded, so an image or container runaway fills its 20G and not
    # the pool.
    {
      unit = "zfs-set-root-docker-quota";
      dataset = "zroot/root/docker";
      property = "quota";
      value = "20G";
      when = null;
    }
    {
      unit = "zfs-set-root-podman-quota";
      dataset = "zroot/root/podman";
      property = "quota";
      value = "20G";
      when = null;
    }
    # The telemetry store's disk envelope (ADR-007 E7.3). Sizes are whole
    # gibibytes, which greptimedb-envelope's environment requires.
    {
      unit = "zfs-set-root-greptimedb-quota";
      dataset = "zroot/root/greptimedb";
      property = "quota";
      value = "16G";
      when = null;
    }
    {
      unit = "zfs-set-root-greptimedb-reservation";
      dataset = "zroot/root/greptimedb";
      property = "reservation";
      value = "12G";
      when = null;
    }
    {
      unit = "zfs-assert-root-greptimedb-noautosnap";
      dataset = "zroot/root/greptimedb";
      property = "com.sun:auto-snapshot";
      value = "false";
      when = null;
    }
    # The PostgreSQL dumps' dataset (back-up-postgresql-off-host design D5),
    # present only with the backup on, as is the dataset.
    {
      unit = "zfs-set-root-postgresql-dumps-quota";
      dataset = "zroot/root/postgresql-dumps";
      property = "quota";
      value = "16G";
      when = "postgresqlBackup";
    }
    {
      unit = "zfs-assert-root-postgresql-dumps-noautosnap";
      dataset = "zroot/root/postgresql-dumps";
      property = "com.sun:auto-snapshot";
      value = "false";
      when = "postgresqlBackup";
    }
    # The local omnigraph root's dataset, present only with the root on the
    # local store, as is the dataset.
    {
      unit = "zfs-set-root-omnigraph-quota";
      dataset = "zroot/root/omnigraph";
      property = "quota";
      value = "20G";
      when = "omnigraphLocalRoot";
    }
  ];
}
