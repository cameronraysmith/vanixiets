{ config, ... }:
{
  flake.modules.darwin."machines/darwin/argentum" = {
    imports = [ config.flake.modules.darwin.darwin-workstation ];

    networking.hostName = "argentum";

    # Omitted developer casks: dbeaver-community, docker-desktop,
    # gpg-suite, inkscape, keycastr, meld, postgres-app
    custom.homebrew.additionalCasks = [
      "zerotier-one"
    ];

    services.localDnscryptProxy = {
      enable = true;
      providers = [
        "quad9"
      ];
      userHome = "/private/var/lib/dnscrypt-proxy";
    };

    # Accept existing nix.conf from nix-installer
    # Hash generated by: shasum -a 256 /etc/nix/nix.conf
    # This allows nix-darwin to replace the file during first activation
    environment.etc."nix/nix.conf".knownSha256Hashes = [
      "5304bbb86b6b5d0a6ae04a7bab297c0fece1b159caf87bb5a757264ad2bddf0b"
    ];
  };
}
