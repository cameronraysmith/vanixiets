{ config, ... }:
{
  flake.modules.darwin."machines/darwin/rosegold" = {
    imports = [ config.flake.modules.darwin.laptop ];

    networking.hostName = "rosegold";

    # Accept existing nix.conf from nix-installer
    # Hash generated by: shasum -a 256 /etc/nix/nix.conf
    # This allows nix-darwin to replace the file during first activation
    environment.etc."nix/nix.conf".knownSha256Hashes = [
      "db06eedc463af208feefb7c804828fd8e1a89a88248fe46df8e3f8562dc6ded2"
    ];
  };
}
