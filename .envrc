# shellcheck shell=bash
if ! has nix_direnv_version || ! nix_direnv_version "3.2.0"; then
  source_url "https://raw.githubusercontent.com/nix-community/nix-direnv/3.2.0/direnvrc" "sha256-hW6NC1JHue3IjZN3uDM6l6I2PMaauqd2D7hXYJ1Zfr4="
fi

# nix-direnv keeps its cached dev shell until a watched file is newer, and it
# watches only flake.nix and flake.lock; these files define the dev shell.
watch_file modules/devshells/default.nix modules/formatting.nix \
  modules/lib/fleet-nix.nix modules/lib/nix-classic.nix \
  pkgs/by-name/nix-fast-build/package.nix

# direnv-instant (configured via home-manager) handles async loading
# Long builds automatically spawn a tmux pane after mux_delay
if ! use flake .#default --accept-flake-config; then
  echo "nix flake could not be built; update flake.nix and run direnv allow/reload" >&2
fi
