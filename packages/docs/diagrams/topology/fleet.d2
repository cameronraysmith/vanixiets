# generated by flake.lib.fleetTopology from the clan inventory, flake.lib.hosts and flake.lib.topologyFacts; run `just topology-generate`, never edit
title: "Fleet placement" {
  shape: text
  near: top-center
  style.font-size: 28
}
direction: down
darwin: "darwin hosts" {
  grid-columns: 3
  argentum: "argentum" {
    grid-columns: 2
    r_nix_builders_builder: "nix-builders/builder"
    r_otel_collector_agent: "otel-collector/agent"
    r_user_cameron_default: "user-cameron/default"
    r_vanixiets_peer: "vanixiets/peer"
  }
  blackphos: "blackphos" {
    grid-columns: 2
    r_user_crs58_default: "user-crs58/default"
  }
  rosegold: "rosegold" {
    grid-columns: 2
    r_nix_builders_builder: "nix-builders/builder"
    r_otel_collector_agent: "otel-collector/agent"
    r_user_cameron_default: "user-cameron/default"
    r_vanixiets_peer: "vanixiets/peer"
  }
  stibnite: "stibnite" {
    grid-columns: 2
    r_nix_builders_builder: "nix-builders/builder"
    r_nix_builders_dispatcher: "nix-builders/dispatcher"
    r_omnigent_host: "omnigent/host"
    r_otel_collector_agent: "otel-collector/agent"
    r_user_crs58_default: "user-crs58/default"
    r_vanixiets_peer: "vanixiets/peer"
  }
}
nixos: "NixOS hosts" {
  grid-columns: 3
  cinnabar: "cinnabar" {
    grid-columns: 2
    r_hermes_agent_default: "hermes-agent/default"
    r_openclaw_default: "openclaw/default"
    r_otel_collector_agent: "otel-collector/agent"
    r_sshd_client: "sshd/client"
    r_sshd_server: "sshd/server"
    r_tor_server: "tor/server"
    r_user_cameron_default: "user-cameron/default"
    r_vanixiets_peer: "vanixiets/peer"
    r_zerotier_controller: "zerotier/controller"
    s_hermes: "hermes" {
      style.fill: "#FFF4D6"
    }
    s_matrix: "matrix" {
      style.fill: "#FFF4D6"
    }
    s_ntfy: "ntfy" {
      style.fill: "#FFF4D6"
    }
    s_radicle: "radicle" {
      style.fill: "#FFF4D6"
    }
  }
  electrum: "electrum" {
    grid-columns: 2
    r_otel_collector_agent: "otel-collector/agent"
    r_sshd_client: "sshd/client"
    r_sshd_server: "sshd/server"
    r_tor_server: "tor/server"
    r_user_cameron_default: "user-cameron/default"
    r_vanixiets_peer: "vanixiets/peer"
    r_zerotier_peer: "zerotier/peer"
  }
  galena: "galena" {
    grid-columns: 2
    r_otel_collector_agent: "otel-collector/agent"
    r_sshd_client: "sshd/client"
    r_sshd_server: "sshd/server"
    r_tor_server: "tor/server"
    r_user_cameron_default: "user-cameron/default"
    r_user_tara_default: "user-tara/default"
    r_vanixiets_peer: "vanixiets/peer"
    r_zerotier_peer: "zerotier/peer"
  }
  magnetite: "magnetite" {
    grid-columns: 2
    r_nix_builders_builder: "nix-builders/builder"
    r_nix_builders_dispatcher: "nix-builders/dispatcher"
    r_omnigent_host: "omnigent/host"
    r_omnigent_server: "omnigent/server"
    r_otel_collector_agent: "otel-collector/agent"
    r_otel_collector_ingress: "otel-collector/ingress"
    r_sshd_client: "sshd/client"
    r_sshd_server: "sshd/server"
    r_tor_server: "tor/server"
    r_user_cameron_default: "user-cameron/default"
    r_vanixiets_peer: "vanixiets/peer"
    r_zerotier_peer: "zerotier/peer"
    s_gitea: "gitea\\ngit.scientistexperience.net\\nport 443" {
      style.fill: "#FFF4D6"
    }
    s_gitea_mq: "gitea-mq\\nmq.scientistexperience.net\\nport 443" {
      style.fill: "#FFF4D6"
    }
    s_greptimedb: "greptimedb" {
      style.fill: "#FFF4D6"
    }
    s_kanidm: "kanidm\\naccounts.scientistexperience.net\\nport 443" {
      style.fill: "#FFF4D6"
    }
    s_matrix: "matrix\\nmatrix.scientistexperience.net\\nport 443" {
      style.fill: "#FFF4D6"
    }
    s_coturn: "coturn\\nport 3478, 5349" {
      style.fill: "#FFF4D6"
    }
    s_livekit: "livekit\\nport 7880, 7881" {
      style.fill: "#FFF4D6"
    }
    s_niks3: "niks3\\nniks3.scientistexperience.net\\nport 443" {
      style.fill: "#FFF4D6"
    }
    s_nixbot: "nixbot\\nnixbot.scientistexperience.net\\nport 443" {
      style.fill: "#FFF4D6"
    }
    s_omnigent: "omnigent\\nomni.scientistexperience.net\\nport 443" {
      style.fill: "#FFF4D6"
    }
    s_omnigraph: "omnigraph" {
      style.fill: "#FFF4D6"
    }
    s_perses: "perses\\nobs.scientistexperience.net\\nport 443" {
      style.fill: "#FFF4D6"
    }
    s_renovate: "renovate" {
      style.fill: "#FFF4D6"
    }
  }
  pyrite: "pyrite" {
    grid-columns: 2
    r_iroh_server: "iroh/server"
    r_nix_builders_builder: "nix-builders/builder"
    r_nix_builders_dispatcher: "nix-builders/dispatcher"
    r_omnigent_host: "omnigent/host"
    r_otel_collector_agent: "otel-collector/agent"
    r_sshd_client: "sshd/client"
    r_sshd_server: "sshd/server"
    r_tor_server: "tor/server"
    r_user_cameron_default: "user-cameron/default"
    r_vanixiets_peer: "vanixiets/peer"
    r_wifi_default: "wifi/default"
    r_zerotier_peer: "zerotier/peer"
  }
  scheelite: "scheelite" {
    grid-columns: 2
    r_otel_collector_agent: "otel-collector/agent"
    r_sshd_client: "sshd/client"
    r_sshd_server: "sshd/server"
    r_tor_server: "tor/server"
    r_user_cameron_default: "user-cameron/default"
    r_user_tara_default: "user-tara/default"
    r_vanixiets_peer: "vanixiets/peer"
    r_zerotier_peer: "zerotier/peer"
  }
}
every_host: "on every host" {
  r_emergency_access_default: "emergency-access/default"
}
key: "Key" {
  host: "host: a box holding its service roles and declared services"
  role: "service role: instance/role, from the clan inventory"
  declared: "declared service: name, public hostnames, ports (flake.lib.topologyFacts)" {
    style.fill: "#FFF4D6"
  }
}
