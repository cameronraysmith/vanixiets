{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sciexp-evidence",
  "main": "src/index.ts",
  "compatibility_date": "2025-10-06",
  "account_id": "1ece4a9a8f092f8cbdd679d22b9ecb1f",
  "r2_buckets": [
    {
      "binding": "EVIDENCE",
      "bucket_name": "sciexp"
    }
  ],
  // Workers Logs record invocation metadata and console output; the Worker
  // never logs, and no request body is read or recorded.
  "observability": {
    "enabled": true
  },
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "evidence.vanixiets.net",
      "custom_domain": true
    }
  ]
}
